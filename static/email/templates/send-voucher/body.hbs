{{> header title=title }}

<mj-section padding="0 25px 20px 25px" border-right="{{ border }}" border-left="{{ border }}" border-bottom="{{ border }}">
    <mj-column>
        <mj-text padding="0 0 10px 0" color="{{ colorFont }}" font-family="{{ fontFamily }}" font-size="22px" line-height="1.25" letter-spacing="0.02em">
            {{ title }}
        </mj-text>
         <mj-text padding="0" color="{{ colorFont }}" font-family="{{ fontFamily }}" font-size="17px" line-height="1.52" font-weight="300">
            <div><b>{{ order.customer.firstName }} {{ order.customer.lastName }},</b></div>
            {{{ text }}}
        </mj-text>
        {{#if voucherZipUrl }}
        <mj-button font-family="{{ fontFamily }}"
                   background-color=" {{ colorCta }}"
                   color="{{ white }}"
                   align="left"
                   href="{{ voucherZipUrl }}"
                   border-radius="0"
                   inner-padding="15px 25px 15px 25px"
                    padding="20px 0 0 0"
                   font-size="15px"
                   line-height="1.17"
                   letter-spacing="0.05em"
                   font-weight="700"
                   >
            {{ voucherZipUrlButtonText }}
        </mj-button>
        {{/if}}
    </mj-column>
</mj-section>

{{> footer }}

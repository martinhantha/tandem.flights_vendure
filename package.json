{
    "name": "tandem-flights-vendure",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev:server": "ts-node ./src/index.ts",
        "dev:worker": "ts-node ./src/index-worker.ts",
        "dev": "concurrently npm:dev:*",
        "devlocal": "nodemon",
        "build": "tsc && yarn copy-files && yarn build:dashboard",
        "build:dashboard": "vite build",
        "copy-files": "copyfiles -u 1 src/plugins/**/translations/**/* dist",
        "start:server": "node ./dist/index.js",
        "start:worker": "node ./dist/index-worker.js",
        "start": "concurrently npm:start:*",
        "codegen": "graphql-codegen --config codegen.ts",
        "populate": "ts-node ./src/populate.ts",
        "postinstall": "patch-package",
        "deploy": "node deploy.js",
        "tandem:seed": "ts-node scripts/tandem-import/seed.ts",
        "tandem:import-products": "ts-node scripts/tandem-import/import-products.ts",
        "tandem:import-vouchers": "ts-node scripts/tandem-import/import-vouchers.ts",
        "tandem:typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tandem-import/tsconfig.json",
        "tandem:image": "bash scripts/tandem-image.sh"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1092.0",
        "@aws-sdk/credential-providers": "^3.1092.0",
        "@aws-sdk/lib-storage": "^3.1092.0",
        "@nestjs/terminus": "^11.0.0",
        "@pdfme/common": "^6.1.11",
        "@pdfme/generator": "^6.1.11",
        "@pdfme/schemas": "^6.1.11",
        "@pdfme/ui": "^6.1.11",
        "@pinelab/vendure-plugin-admin-ui-helpers": "^1.2.0",
        "@pinelab/vendure-plugin-google-cloud-tasks": "^2.1.0",
        "@pinelab/vendure-plugin-google-storage-assets": "^2.2.0",
        "@pinelab/vendure-plugin-metrics": "3.1.0",
        "@pinelab/vendure-plugin-modify-customer-orders": "^1.3.1",
        "@pinelab/vendure-plugin-order-export": "^1.5.2",
        "@tiptap/react": "^3.20.0",
        "@vendure-community/stripe-plugin": "1.0.0",
        "@vendure/asset-server-plugin": "3.8.2",
        "@vendure/common": "3.8.2",
        "@vendure/core": "3.8.2",
        "@vendure/create": "3.8.2",
        "@vendure/dashboard": "3.8.2",
        "@vendure/email-plugin": "3.8.2",
        "@vendure/harden-plugin": "3.8.2",
        "cron": "^4.1.0",
        "dayjs": "^1.11.13",
        "dotenv": "17.4.2",
        "html-to-text": "^10.0.0",
        "ioredis": "^5.8.2",
        "jszip": "^3.10.1",
        "pg": "8.22.0",
        "qrcode": "^1.5.4",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "stripe": "^22.1.1"
    },
    "devDependencies": {
        "@babel/preset-react": "^8.0.1",
        "@babel/preset-typescript": "^8.0.1",
        "@graphql-codegen/cli": "7.2.0",
        "@graphql-codegen/client-preset": "6.1.0",
        "@graphql-codegen/typescript": "6.1.0",
        "@types/html-to-text": "^9.0.4",
        "@types/qrcode": "^1.5.5",
        "@types/react": "19.2.17",
        "@vendure/cli": "3.8.2",
        "concurrently": "10.0.3",
        "copyfiles": "2.4.1",
        "nodemon": "^3.1.9",
        "patch-package": "^8.0.1",
        "postinstall-postinstall": "^2.1.0",
        "ts-node": "10.9.2",
        "typescript": "5.8.2"
    },
    "resolutions": {
        "typescript": "5.8.2",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "prosemirror-state": "1.4.4",
        "prosemirror-view": "1.42.1",
        "prosemirror-model": "1.25.11",
        "prosemirror-transform": "1.12.0"
    },
    "packageManager": "yarn@1.22.19+sha1.4ba7fc5c6e704fce2066ecbfb0b0d8976fe62447"
}

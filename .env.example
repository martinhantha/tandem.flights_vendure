# tandem.flights Vendure backend - copy to .env and fill in. Never commit .env.

# --- App ---------------------------------------------------------------
# dev | prod
APP_ENV=
# true = local development (assets on local disk, Elasticsearch on localhost:9201, URLs with :3001)
APP_LOCAL=
APP_DOMAIN=
APP_PORT=
# 4000 in Docker/Coolify (compose.yml port + healthcheck), 3001 for local development
PORT=4000
# backend URLs (shop-api, dashboard, assets, voucher PDF links). Local: APP_URL_DEV=http://localhost (+ :3001 when APP_LOCAL=true)
APP_URL_DEV=http://localhost
APP_URL_PROD=https://ecommerce.tandem.flights
LOGGING_LEVEL=
VENDURE_DISABLE_TELEMETRY=true
COOKIE_SECRET=
# 32 bytes, base64: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# browser origins allowed by CORS (comma separated); default = the list below
CORS_ORIGINS=https://www.tandem.flights,https://tandem.flights,https://cms.tandem.flights,http://localhost:3000,http://localhost:3001

# --- Superadmin ----------------------------------------------------------
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# --- Database (Postgres) -------------------------------------------------
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_SCHEMA=public

# --- Shop ----------------------------------------------------------------
SHOP_NAME=Tandem Flights Sarntal
SHOP_EMAIL=info@tandem.flights
SHOP_PHONE=+39 379 280 6070
# copy of every order confirmation (GlobalSettings.orderEmailCopyTo, written by yarn tandem:seed)
SHOP_ORDER_COPY_EMAIL=info@tandem.flights
SHOP_URL_DEV=http://localhost:3000
SHOP_URL_PROD=https://www.tandem.flights

# --- Vouchers ------------------------------------------------------------
SHOP_VOUCHER_CODE_PREFIX=
# 8 random characters [0-9A-Z] like the old shop
SHOP_VOUCHER_CODE_LENGTH=8
# QR code content on the voucher PDF = this + code
SHOP_VOUCHER_QR_URL=https://tandem.flights/qr?key=
SHOP_VOUCHER_PATH=pdfs/voucher-
VOUCHER_PATH=pdfs/voucher-
# false = vouchers can only be redeemed on-site (dashboard), applyCouponCode rejects them
SHOP_VOUCHER_REDEEM_ONLINE=false
# checkVoucher requests per client IP and minute
CHECK_VOUCHER_RATE_LIMIT=20

# --- E-Mail (SMTP) -------------------------------------------------------
# empty SMTP_HOST = mails are written to static/email/test-emails (http://localhost:3001/mailbox)
# Aruba mailbox info@tandem.flights: smtps.aruba.it, port 587 with STARTTLS (SMTP_SECURE=false, SMTP_REQUIRE_TLS=true)
# (implicit TLS instead: SMTP_PORT=465 SMTP_SECURE=true)
SMTP_HOST=smtps.aruba.it
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
# SMTP_USER = info@tandem.flights, password from the Aruba mailbox
SMTP_USER=
SMTP_PASSWORD=

# --- PayPal (written to the "paypal" payment method by yarn tandem:seed) --
# REST app credentials of the business account (see TANDEM.md); while empty the "paypal" method stays disabled
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# sandbox | live
PAYPAL_MODE=sandbox
PAYPAL_CANCEL_PATH=checkout
PAYPAL_RETURN_PATH=checkout/success

# --- Stripe (written to the "stripe" payment method by yarn tandem:seed) --
STRIPE_SECRET_KEY=
# local: stripe listen --forward-to localhost:3001/payments/stripe
STRIPE_WEBHOOK_SECRET=
# used by the Nuxt frontend only, listed here for completeness
STRIPE_PUBLISHABLE_KEY=

# --- Asset storage (S3 compatible, prod) ----------------------------------
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_ENDPOINT=

# --- Redis (optional collection menu cache) -------------------------------
REDIS_URL=
REDIS_USERNAME=
REDIS_PASSWORD=
COLLECTION_MENU_REDIS_DISABLED=
COLLECTION_MENU_CACHE_TTL_SECONDS=

# --- Deploy / import (local only) ----------------------------------------
COOLIFY_DEPLOY_TOKEN=
DEPLOY_SCRIPT_HOME=
# path of the old TYPO3 MariaDB dump for yarn tandem:import-* (contains personal data - keep outside the repo)
TANDEM_SQL_DUMP=

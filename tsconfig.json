{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noLib": false,
        "skipLibCheck": true,
        "lib": ["es2019", "esnext.asynciterable"],
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "target": "es2019",
        "strict": true,
        "strictPropertyInitialization": false,
        "sourceMap": false,
        "newLine": "LF",
        "resolveJsonModule": true,
        "outDir": "./dist",
        "baseUrl": "./",
        "paths": {
            "@config": ["src/vendure-config"],
            "src/gql/*": ["src/gql/*"]
        }
    },
    "exclude": ["node_modules", "migration.ts", "src/plugins/**/ui/**", "admin-ui", "src/plugins/**/dashboard/**", "vite.*.*ts"],
    "include": ["src/**/*.ts", "admin-ui/dist/**/*"],
    "ts-node": {
        "files": true
    }
}